;; My Kanata keymap for PC
;; - Control on spacebar: the pain-killer for keyboards with only one Ctrl key
;; - Navigation layer on left Alt that preserves the Alt key behavior (Alt-Tab just works)
;; - Home Row mods, even if control on spacebar, as it makes shift and combos more comfortable

(defvar
  ;; The key must be pressed twice in 200ms to enable repetitions.
  tap_timeout        200
  short_hold_timeout 120
  med_hold_timeout   150
  ;; Slightly higher value for typing keys, to prevent unexpected hold effect.
  long_hold_timeout  180
  chord_timeout      20
  dance_timeout      200
)

(defcfg
  ;; Enabled makes kanata process keys that are not defined in defsrc
  ;; Fixes altgr for Windows (see Arsenik issue #22)
  process-unmapped-keys yes
  windows-altgr cancel-lctl-press
  concurrent-tap-hold true ;; for defchordsv2 to work
  danger-enable-cmd false
)

(defchordsv2
  ;; Map evil copilot key to something useful
  (lsft lmet f23) del 10 first-release ()
)

(deffakekeys
  ;; Alt-Tab from https://github.com/rpnfan/Anymak
  ;; needed for alt-tab to work on layer, realized with multi and macro definitions
  vk-alt  lalt
  vk-ctl  lctl
  vk-nvlk (layer-while-held nav-layer)
)

(defalias
  ;; Shortcuts
  zoin  C-+
  zoot  C--

  ;; Nav
  nav (multi
    (on-press release-virtualkey vk-alt)
    (on-press release-virtualkey vk-ctl)
    (layer-while-held nav-layer)
    (on-release release-virtualkey vk-alt)
    (on-release release-virtualkey vk-ctl)
  )

  ;; Row mods
  aa    (tap-hold       $tap_timeout $long_hold_timeout a    lmet)
  ss    (tap-hold       $tap_timeout $long_hold_timeout s    lalt)
  dd    (tap-hold       $tap_timeout $long_hold_timeout d    lctl)
  ff    (tap-hold       $tap_timeout $long_hold_timeout f    lsft)
  jj    (tap-hold       $tap_timeout $long_hold_timeout j    rsft)
  kk    (tap-hold       $tap_timeout $long_hold_timeout k    rctl)
  ll    (tap-hold       $tap_timeout $long_hold_timeout l    lalt)
  rmet  (tap-hold       $tap_timeout $long_hold_timeout ;    rmet)

  ;; Thumbs
  t1l  (tap-hold $tap_timeout $short_hold_timeout lmet lalt)
  t2l  (tap-hold $tap_timeout $short_hold_timeout bspc lctl)
  spc  (tap-hold $tap_timeout $med_hold_timeout   spc  @nav)
  t2r  (tap-hold $tap_timeout $short_hold_timeout del  (multi ralt (layer-while-held sym-layer)))

  ;; Nav
  atab  (macro (on-press release-virtualkey vk-ctl) (on-press press-virtualkey vk-alt) 10 tab) ;; needs a short delay to not trigger tab on the first press - 1 is fine, 5 or higher to be on the safe side
  astb  (macro (on-press release-virtualkey vk-ctl) (on-press press-virtualkey vk-alt) 10 S-tab) ;; needs a short delay to not trigger tab on the first press - 1 is fine, 5 or higher to be on the safe side
  ctab  (macro (on-press release-virtualkey vk-alt) (on-press press-virtualkey vk-ctl) 10 tab)
  stab  (macro (on-press release-virtualkey vk-alt) (on-press press-virtualkey vk-ctl) 10 S-tab)
  nvlk  (on-press toggle-vkey vk-nvlk)
  nvspc (tap-hold $tap_timeout $short_hold_timeout
    (macro
      (on-press release-virtualkey vk-ctl)
      (on-press release-virtualkey vk-alt) ret)
    lsft)
)

(defsrc
  tab   q     w     e     r     t               y     u     i     o     p     [     ]
  caps  a     s     d     f     g               h     j     k     l     ;     '
        z     x     c     v     b               n     m     ,     .     /
  lctl  lmet  lalt                     spc               ralt
)

(deflayer base-layer
  tab   q     w     e     r     t               y     u     i     o     p     [     ]
  esc   a     @ss   @dd   @ff   g               h   @jj   @kk   @ll     ;     '
        z     x     c     v     b               n     m     ,     .     /
  lmet  @t1l  @t2l                    @spc               @t2r
)

(deflayer nav-layer
  _     @stab @ctab @atab  bck  XX           pgup  home     ▲   end   esc  bspc   del
  caps  lmet  lalt  lctl   fwd  XX           pgdn     ◀     ▼     ▶   tab   ret
        XX    XX    bck    fwd  lrld        @nvlk   C-◀   C-▶   C-▶    XX
  _     _     _                      @nvspc                 _
)

(deflayer sym-layer
  _     _     _     _     _     _               _     _     _     _     _     _     _
  _     _     _     _     _     _               _     _     _     _     _     _
        _     _     _     _     _               _     _     _     _     _
  _     _     C-bspc                   ret                  _
)

(deflayer void
  _     _     _     _     _     _               _     _     _     _     _     _     _
  _     _     _     _     _     _               _     _     _     _     _     _
        _     _     _     _     _               _     _     _     _     _
  _     _     _                         _                   _
)
